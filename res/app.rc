#include <winres.h>
#include "resource.h"

IDI_APP ICON "app-icon.ico"

1 RT_MANIFEST "tokitoki-windows.exe.manifest"

/* Release builds embed the pinned/locally built shared CLI; dev builds
 * (no payload on disk) simply omit the resources and bootstrap is a no-op. */
#ifdef EMBED_CLI
IDR_CLI_GZ RCDATA "..\\embedded\\tokitoki.exe.gz"
IDR_CLI_VERSION RCDATA "..\\embedded\\VERSION"
#endif

/* build.ps1 generates version_res.h (in the build dir, on the rc include
 * path) with the real version before every resource compile. */
#include "version_res.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION TOKITOKI_VER_FIELDS
PRODUCTVERSION TOKITOKI_VER_FIELDS
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", "Tokitoki"
            VALUE "ProductVersion", TOKITOKI_VERSION_STR
            VALUE "FileVersion", TOKITOKI_VERSION_STR
            VALUE "FileDescription", "Tokitoki system-tray agent for Windows"
            VALUE "OriginalFilename", "tokitoki-windows.exe"
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
